<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): the SkillServe tile over its own edge
     green, so every launcher mask (circle, squircle, rounded square) shows the
     green tile with the S mark instead of a small icon inside a white plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
